{
  "name": "@hoshinotatsuya/deps-guard",
  "version": "0.7.2",
  "description": "Supply-chain gate for npm dependencies in CI and commit hooks: new dependencies need a reason, install scripts need a decision, packages must come from allowed registries with integrity, plus look-alike names, fresh versions, floating ranges and banned packages in the installed tree.",
  "keywords": [
    "supply-chain",
    "security",
    "dependencies",
    "lockfile",
    "pnpm",
    "npm",
    "yarn",
    "install-scripts",
    "typosquatting",
    "ci",
    "sarif",
    "jest"
  ],
  "license": "MIT",
  "author": "Hoshino_Tatsuya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoshinoTatsuya/deps-guard.git"
  },
  "homepage": "https://github.com/HoshinoTatsuya/deps-guard#readme",
  "bugs": {
    "url": "https://github.com/HoshinoTatsuya/deps-guard/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jest": {
      "types": "./dist/jest/deps-guard-gate.d.ts",
      "default": "./dist/jest/deps-guard-gate.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "jest": [
        "./dist/jest/deps-guard-gate.d.ts"
      ]
    }
  },
  "bin": {
    "deps-guard": "bin/deps-guard.cjs"
  },
  "files": [
    "bin",
    "data",
    "dist",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples",
    "lint": "biome check src bin examples",
    "test": "pnpm run build && jest-groups --out .jest-report.json -- node_modules/.bin/jest && jest-assert-no-skipped .jest-report.json",
    "test:consumers": "scripts/consumer-matrix.sh",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run test:consumers && pnpm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@jest/globals": ">=29"
  },
  "peerDependenciesMeta": {
    "@jest/globals": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@jest/globals": "30.5.2",
    "@hoshinotatsuya/arch-gates": "^0.12.2",
    "@hoshinotatsuya/jest-groups": "^0.7.2",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.0.15",
    "jest": "30.5.2",
    "js-yaml": "4.1.1",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.5",
    "typescript": "5.9.3",
    "yaml": "2.8.1"
  }
}
